//kage:unit pixels

package main

const SmoothK = {{float .SmoothK}}
const MaxMainCircles = {{.MainCircles}}
{{if gt .MainBridges 0}}const MaxMainBridges = {{.MainBridges}}{{end}}
{{if gt .OtherCircles 0}}const MaxOtherCircles = {{.OtherCircles}}{{end}}
{{if gt .OtherBridges 0}}const MaxOtherBridges = {{.OtherBridges}}{{end}}
const EdgeThickness = {{float .EdgeThickness}}

var Resolution vec2
var MainColor vec4
var MainCircleCount int
var MainCircles [MaxMainCircles]vec4
{{if gt .MainBridges 0}}
var MainBridgeCount int
var MainBridgeEnds [MaxMainBridges]vec4
var MainBridgeRadii [MaxMainBridges]vec3
{{end -}}
{{if gt .OtherCircles 0}}
var OtherCircleCount int
var OtherCircles [MaxOtherCircles]vec4
{{end -}}
{{if gt .OtherBridges 0}}
var OtherBridgeCount int
var OtherBridgeEnds [MaxOtherBridges]vec4
var OtherBridgeRadii [MaxOtherBridges]vec3
{{end}}

func smin(a, b, k float) float {
	h := clamp(0.5+0.5*(b-a)/k, 0.0, 1.0)
	return mix(b, a, h) - k*h*(1.0-h)
}

// xy = surface gradient, z = distance, w = distance from center/axis
func sminField(a, b vec4, k float) vec4 {
	h := clamp(0.5+0.5*(b.z-a.z)/k, 0.0, 1.0)

	dist := mix(b.z, a.z, h) - k*h*(1.0-h)
	grad := mix(b.xy, a.xy, h)

	// Interpolate actual feature radius.
	radius := mix(b.w, a.w, h)

	return vec4(grad, dist, radius)
}

func sdCircleField(p vec2, circle vec4) vec4 {
	d := p - circle.xy
	d2 := dot(d, d)
	rawDist := sqrt(d2)
	grad := d * inversesqrt(max(d2, 1e-12))
	// w = feature radius
	return vec4(grad, rawDist-circle.z, circle.z)
}

{{if or (gt .MainBridges 0) (gt .OtherBridges 0)}}
func sdSplineCapsuleField(
	p vec2,
	a vec2,
	b vec2,
	r1 float,
	r2 float,
	r3 float,
) vec4 {
	ba := b - a
	pa := p - a

	ba2 := max(dot(ba, ba), 1e-12)
	invBa2 := 1.0 / ba2
	t := clamp(dot(pa, ba)*invBa2, 0.0, 1.0)

	q := pa - ba*t

	// First/second half of spline.
	side := step(0.5, t)
	x := 2.0*t - side

	ra := mix(r1, r2, side)
	rb := mix(r2, r3, side)
	dr := rb - ra

	// smoothstep interpolation.
	s := x*x*(3.0-2.0*x)
	radius := ra + dr*s

	// d(radius)/dt, to account for the radius sweep when computing the gradient.
	drdt := 12.0 * dr * x * (1.0 - x)

	q2 := dot(q, q)
	invQ := inversesqrt(max(q2, 1e-12))

	grad := q*invQ - drdt*ba*invBa2
	rawDist := q2 * invQ

	return vec4(grad, rawDist-radius, radius)
}
{{end}}

func edge(dist float, grad vec2, radius float) float {
	lightDir := {{vec2 .LightDirX .LightDirY}}

	thickness := min(EdgeThickness, max(radius, 1e-4))

	grad2 := dot(grad, grad)
	gradLen := sqrt(grad2)

	// Polynomial smin isn't a true SDF in the blend region.
	dist /= max(gradLen, 0.25)

	u := clamp(dist/-thickness, 0.0, 1.0)
	edgeAmount := 1.0 - u*(2.0-u)

	normal := grad * inversesqrt(max(grad2, 1e-12))

	// At the medial axis, opposing primitive gradients cancel.
	// Directional lighting there has no meaningful normal.
	normalStrength := smoothstep(0.15, 0.5, gradLen)

	lighting := dot(normal, lightDir) * normalStrength

	return mix(0.75, 1.0, edgeAmount*lighting)
}

func Fragment(dstPos vec4) vec4 {
	uv := dstPos.xy / Resolution

	k := SmoothK
	big := 100.0

	// ------------------------------------------------------------
	// Main visible field
	// ------------------------------------------------------------
	mainField := vec4(0.0, 0.0, big, big)

	for i := 0; i < MaxMainCircles; i++ {
		// Kage loop bounds must be constant; the real count is enforced with break.
		if i >= MainCircleCount {
			break
		}

		mainField = sminField(
			mainField,
			sdCircleField(uv, MainCircles[i]),
			k,
		)
	}
	{{if gt .MainBridges 0}}
	for i := 0; i < MaxMainBridges; i++ {
		if i >= MainBridgeCount {
			break
		}

		end := MainBridgeEnds[i]
		radius := MainBridgeRadii[i]

		mainField = sminField(
			mainField,
			sdSplineCapsuleField(
				uv,
				end.xy,
				end.zw,
				radius.x,
				radius.y,
				radius.z,
			),
			k,
		)
	}
	{{end}}

{{if and (eq .OtherCircles 0) (eq .OtherBridges 0)}}
	squeezedDist := mainField.z
	squeezedGrad := mainField.xy
{{else}}
	// ------------------------------------------------------------
	// Combined invisible "everything else" field
	// ------------------------------------------------------------

	otherField := vec4(0.0, 0.0, big, big)

	{{if gt .OtherCircles 0}}
	for i := 0; i < MaxOtherCircles; i++ {
		if i >= OtherCircleCount {
			break
		}

		otherField = sminField(
			otherField,
			sdCircleField(uv, OtherCircles[i]),
			k,
		)
	}
	{{end}}

	{{if gt .OtherBridges 0}}
	for i := 0; i < MaxOtherBridges; i++ {
		if i >= OtherBridgeCount {
			break
		}

		end := OtherBridgeEnds[i]
		radius := OtherBridgeRadii[i]

		otherField = sminField(
			otherField,
			sdSplineCapsuleField(
				uv,
				end.xy,
				end.zw,
				radius.x,
				radius.y,
				radius.z,
			),
			k,
		)
	}
	{{end}}

	// ------------------------------------------------------------
	// Squeezing
	// ------------------------------------------------------------
	squeezeField := sminField(
		otherField,
		vec4(0.0, 0.0, 0.0, 0.0),
		k*0.5,
	)
	squeezedDist := mainField.z - squeezeField.z
	squeezedGrad := mainField.xy - squeezeField.xy
{{end}}

	if squeezedDist >= 0.0 {
		discard()
	}

	factor := edge(squeezedDist, squeezedGrad, mainField.w)
	return vec4(MainColor.rgb*factor, MainColor.a)
}
