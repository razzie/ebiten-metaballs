{{define "basic.fields"}}

func sminField(a, b vec4, k float) vec4 {
	if a.w == 0.0 {
		return b
	}
	h := clamp(0.5+0.5*(b.z-a.z)/k, 0.0, 1.0)
	var field vec4
	field.z = mix(b.z, a.z, h)-k*h*(1.0-h)
	field.w = mix(b.w, a.w, h)
	return field
}

func sdCircleField(p vec2, circle vec4) vec4 {
	var field vec4
	field.z = length(p-circle.xy)-circle.z
	field.w = circle.z
	return field
}

{{if gt .Bridges 0}}
func sdSplineCapsuleField(p vec2, ends, radii vec4) vec4 {
	ba := ends.zw - ends.xy
	pa := p - ends.xy

	ba2 := max(dot(ba, ba), 1e-12)
	invBa2 := 1.0 / ba2
	t := clamp(dot(pa, ba)*invBa2, 0.0, 1.0)

	q := pa - ba*t

	// First/second half of spline.
	side := step(0.5, t)
	x := 2.0*t - side

	ra := mix(radii.x, radii.y, side)
	rb := mix(radii.y, radii.z, side)
	dr := rb - ra

	// smoothstep interpolation.
	s := x * x * (3.0 - 2.0*x)
	radius := ra + dr*s

	var field vec4
	field.z = length(q)-radius
	field.w = radius
	return field
}
{{end}}

{{if gt .Walls 0}}
func sdWallField(p vec2, ends vec4, radius float) vec4 {
	ba := ends.zw-ends.xy
	pa := p-ends.xy
	t := clamp(dot(pa, ba)/max(dot(ba, ba), 1e-12), 0.0, 1.0)
	q := pa-ba*t
	// Keep zero-width lines present without giving them a visible radius.
	return vec4(0.0, 0.0, length(q)-radius, max(radius, 1e-6))
}

func excludeWallField(main, wall vec4, k float) vec4 {
	h := clamp(0.5+0.5*(-wall.z-main.z)/k, 0.0, 1.0)
	return vec4(0.0, 0.0, mix(main.z, -wall.z, h)+k*h*(1.0-h), main.w)
}
{{end}}

// Subtract a smooth minimum of the nearest competing GROUP distance and zero.
// Competitors are never smooth-unioned together, so extra colors do not inflate
// the opposing field. The transition rounds the exposed ends of a contact.
func squeezeField(main, other vec4, k float) vec4 {
	h := clamp(0.5-0.5*other.z/k, 0.0, 1.0)
	var field vec4
	field.z = main.z-other.z*h+k*h*(1.0-h)
	field.w = main.w
	return field
}

{{/* End of basic.fields */}}
{{end}}

{{define "basic.lighting"}}
func edge(field vec4) float {
	return 1.0
}
{{end}}
