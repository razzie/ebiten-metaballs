//kage:unit pixels

package main

const SmoothK = {{float .SmoothK}}
const MaxGroups = {{.Groups}}
const MaxCircles = {{.Circles}}
{{if gt .Bridges 0}}const MaxBridges = {{.Bridges}}{{end}}
{{if or .LightDirX .LightDirY}}const EdgeThickness = {{float .EdgeThickness}}{{end}}

var UvScale vec2
var UvOffset vec2
var PixelOrigin vec2
var GroupCount int
var GroupColors [MaxGroups]vec4
var CircleCount int
// xy = center, z = radius, w = group ID
var Circles [MaxCircles]vec4
{{if gt .Bridges 0}}
var BridgeCount int
var BridgeEnds [MaxBridges]vec4
// xyz = endpoint/middle radii, w = group ID
var BridgeRadii [MaxBridges]vec4
{{end}}

// Field values: xy = distance gradient, z = distance, w = blended radius.
// A zero radius marks an empty group. Basic rendering leaves xy unassigned.
{{if or .LightDirX .LightDirY}}
{{template "edge.fields" .}}
{{template "edge.lighting" .}}
{{else}}
{{template "basic.fields" .}}
{{template "basic.lighting" .}}
{{end}}

func Fragment(dstPos vec4) vec4 {
	uv := (dstPos.xy-imageDstOrigin()+PixelOrigin)*UvScale + UvOffset
	var fields [MaxGroups]vec4

	// Evaluate every primitive once, accumulating into its own group's smooth distance field.
	// Do not cut off individual distances at SmoothK: positive intermediate
	// blends can carry their influence into the final contour.
	// Count checks are uniform across pixels; keep them to skip unused slots.
	for i := 0; i < MaxCircles; i++ {
		if i >= CircleCount {
			break
		}
		circle := Circles[i]
		if circle.z <= 0.0 {
			continue
		}
		field := sdCircleField(uv, circle)
		g := int(circle.w)
		fields[g] = sminField(fields[g], field, SmoothK)
	}
	{{if gt .Bridges 0}}
	for i := 0; i < MaxBridges; i++ {
		if i >= BridgeCount {
			break
		}
		ends := BridgeEnds[i]
		radii := BridgeRadii[i]
		field := sdSplineCapsuleField(uv, ends, radii)
		if field.w <= 0.0 {
			continue
		}
		g := int(radii.w)
		fields[g] = sminField(fields[g], field, SmoothK)
	}
	{{end}}

	selected := 0
	{{if eq .Groups 1}}
	// A single-group shader needs no ownership scan or contact squeezing.
	squeezed := fields[0]
	{{else}}
	// Only the lowest group distance can survive squeezing. Track the two
	// lowest fields in one scan instead of comparing every pair of groups.
	// A competitor at or beyond SmoothK/2 contributes zero to squeezing.
	// This neutral field also handles missing groups without presence checks.
	main := vec4(0.0, 0.0, SmoothK/2.0, 0.0)
	other := main
	for g := 0; g < MaxGroups; g++ {
		if g >= GroupCount {
			break
		}
		field := fields[g]
		if field.w == 0.0 {
			continue
		}
		// Strict comparisons keep the earlier group when distances tie.
		if field.z < main.z {
			other = main
			main = field
			selected = g
		} else if field.z < other.z {
			other = field
		}
	}
	if main.z >= 0.0 {
		discard()
		return vec4(0.0)
	}
	squeezed := squeezeField(main, other, SmoothK/2.0)
	{{end}}
	if squeezed.z >= 0.0 {
		discard()
	}
	color := GroupColors[selected]
	factor := edge(squeezed)
	return vec4(color.rgb*factor, color.a)
}
