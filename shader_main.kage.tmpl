//kage:unit pixels

package main

const SmoothK = {{float .SmoothK}}
const MaxGroups = {{.Groups}}
{{if gt .Circles 0}}const MaxCircles = {{.Circles}}{{end}}
{{if gt .Walls 0}}const MaxWalls = {{.Walls}}{{end}}
{{if gt .Bridges 0}}const MaxBridges = {{.Bridges}}{{end}}
{{if or .LightDirX .LightDirY}}const EdgeThickness = {{float .EdgeThickness}}{{end}}
{{if .BorderThickness}}const BorderThickness = {{float .BorderThickness}}{{end}}

var UvScale vec2
var UvOffset vec2
var PixelOrigin vec2
var GroupCount int
var GroupColors [MaxGroups]vec4
var CircleCount int
// xy = center, z = radius, w = group ID
{{if gt .Circles 0}}var Circles [MaxCircles]vec4{{end}}
{{if gt .Walls 0}}
var WallCount int
var WallEnds [MaxWalls]vec4
// x = half thickness, y = group ID
var WallData [MaxWalls]vec2
{{end}}
{{if gt .Bridges 0}}
var BridgeCount int
var BridgeEnds [MaxBridges]vec4
// xyz = endpoint/middle radii, w = group ID
var BridgeRadii [MaxBridges]vec4
{{end}}

// Field values: xy = distance gradient, z = distance, w = blended radius.
// A zero radius marks an empty group. Basic rendering leaves xy unassigned.
{{if or .LightDirX .LightDirY}}
{{template "edge.fields" .}}
{{template "edge.lighting" .}}
{{else}}
{{template "basic.fields" .}}
{{template "basic.lighting" .}}
{{end}}

func Fragment(dstPos vec4) vec4 {
	uv := (dstPos.xy-imageDstOrigin()+PixelOrigin)*UvScale + UvOffset
	var fields [MaxGroups]vec4

	// Evaluate every primitive once, accumulating into its own group's smooth distance field.
	// Smooth-min is not associative; callers must keep primitive order stable
	// between frames to avoid shape changes when the same geometry is reordered.
	// Do not cut off individual distances at SmoothK: positive intermediate
	// blends can carry their influence into the final contour.
	// Count checks are uniform across pixels; keep them to skip unused slots.
	{{if gt .Circles 0}}
	for i := 0; i < MaxCircles; i++ {
		if i >= CircleCount {
			break
		}
		circle := Circles[i]
		{{if .BorderThickness}}
		// Zero-radius circles are explicit joints, equivalent to border-radius circles.
		if circle.z == 0.0 {
			circle.z = BorderThickness
		}
		{{end}}
		if circle.z <= 0.0 {
			continue
		}
		field := sdCircleField(uv, circle)
		g := int(circle.w)
		fields[g] = sminField(fields[g], field, SmoothK)
	}
	{{end}}
	{{if gt .Bridges 0}}
	for i := 0; i < MaxBridges; i++ {
		if i >= BridgeCount {
			break
		}
		ends := BridgeEnds[i]
		radii := BridgeRadii[i]
		{{if .BorderThickness}}
		// Retain a solid connector all the way into a joint. Endpoint radii
		// arrive at half the circle radius; preserve the requested middle radius.
		radii.x = max(radii.x, BorderThickness)
		radii.z = max(radii.z, BorderThickness)
		{{end}}
		field := sdSplineCapsuleField(uv, ends, radii)
		if field.w <= 0.0 {
			continue
		}
		g := int(radii.w)
		fields[g] = sminField(fields[g], field, SmoothK)
	}
	{{end}}

	{{if gt .Walls 0}}
	var walls [MaxGroups]vec4
	for i := 0; i < MaxWalls; i++ {
		if i >= WallCount {
			break
		}
		data := WallData[i]
		field := sdWallField(uv, WallEnds[i], data.x)
		g := int(data.y)
		fields[g] = sminField(fields[g], field, SmoothK)
		// Hard union: the protected shape is exactly the supplied wall geometry.
		if walls[g].w == 0.0 || field.z < walls[g].z {
			walls[g] = field
		}
	}
	{{end}}

	selected := 0
	{{if eq .Groups 1}}
	// A single-group shader needs no ownership scan or contact squeezing.
	squeezed := fields[0]
	{{else}}
	// Track the two lowest fields for ordinary contact squeezing in one scan.
	// Rigid wall cores restored below can change the final owner.
	// A competitor at or beyond SmoothK/2 contributes zero to squeezing.
	// This neutral field also handles missing groups without presence checks.
	main := vec4(0.0, 0.0, SmoothK/2.0, 0.0)
	other := main
	for g := 0; g < MaxGroups; g++ {
		if g >= GroupCount {
			break
		}
		field := fields[g]
		if field.w == 0.0 {
			continue
		}
		// Strict comparisons keep the earlier group when distances tie.
		if field.z < main.z {
			other = main
			main = field
			selected = g
		} else if field.z < other.z {
			other = field
		}
	}
	if main.z >= 0.0 {
		discard()
		return vec4(0.0)
	}
	{{if gt .Walls 0}}
	// Find the nearest two wall groups so every group's foreign-wall lookup
	// stays constant time, including groups that contain walls themselves.
	wallMain := vec4(0.0)
	wallOther := wallMain
	wallGroup := -1
	for g := 0; g < MaxGroups; g++ {
		if g >= GroupCount {
			break
		}
		wall := walls[g]
		if wall.w == 0.0 {
			continue
		}
		if wallMain.w == 0.0 || wall.z < wallMain.z {
			wallOther = wallMain
			wallMain = wall
			wallGroup = g
		} else if wallOther.w == 0.0 || wall.z < wallOther.z {
			wallOther = wall
		}
	}
	nearestGroup := selected
	squeezed := vec4(0.0, 0.0, SmoothK, 0.0)
	for g := 0; g < MaxGroups; g++ {
		if g >= GroupCount {
			break
		}
		field := fields[g]
		if field.w == 0.0 {
			continue
		}
		competitor := main
		if g == nearestGroup {
			competitor = other
		}
		candidate := squeezeField(field, competitor, SmoothK/2.0)
		wall := wallMain
		if g == wallGroup {
			wall = wallOther
		}
		if wall.w != 0.0 {
			// Smooth intersection with the outside of a foreign wall gives the
			// deformable group the full displacement at this rigid contact.
			candidate = excludeWallField(candidate, wall, SmoothK/2.0)
		}
		// Restore the rigid core after squeezing, preserving same-group blends
		// outside it. Overlapping walls retain their union.
		if walls[g].w != 0.0 && walls[g].z < candidate.z {
			candidate = walls[g]
		}
		if candidate.z < squeezed.z {
			squeezed = candidate
			selected = g
		}
	}
	{{else}}
	squeezed := squeezeField(main, other, SmoothK/2.0)
	{{end}}
	{{end}}
	if squeezed.z >= 0.0 {
		discard()
	}
	color := GroupColors[selected]
	{{if .BorderThickness}}
	// Apply the border after contact squeezing so boundaries between groups
	// are outlined too. Keep the same border contour with and without lighting.
	if squeezed.z >= -BorderThickness || squeezed.w <= BorderThickness {
		return vec4(color.rgb*0.35, color.a)
	}
	// Light the inset surface from its own edge, not from the outer silhouette.
	squeezed.z += BorderThickness
	squeezed.w -= BorderThickness
	{{end}}
	factor := edge(squeezed)
	return vec4(color.rgb*factor, color.a)
}
