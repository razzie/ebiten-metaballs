//kage:unit pixels

package main

const (
	fxaaReduceMin = 1.0 / {{floatDefault .FxaaReduceMin 128.0}}
	fxaaReduceMul = 1.0 / {{floatDefault .FxaaReduceMul 8.0}}
	fxaaSpanMax   = {{floatDefault .FxaaSpanMax 8.0}}
)

func luma(c vec3) float {
	// Cheap perceptual luminance approximation.
	return dot(c, vec3(0.299, 0.587, 0.114))
}

func sample(pos vec2) vec4 {
	// Extend the boundary pixels so out-of-bounds samples do not fade the
	// canvas border toward transparent black.
	origin := imageSrc0Origin()
	return imageSrc0At(clamp(pos, origin+vec2(0.5), origin+imageSrc0Size()-vec2(0.5)))
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Center + diagonal neighbours.
	rgbM := sample(srcPos).rgb

	rgbNW := sample(srcPos + vec2(-1, -1)).rgb
	rgbNE := sample(srcPos + vec2( 1, -1)).rgb
	rgbSW := sample(srcPos + vec2(-1,  1)).rgb
	rgbSE := sample(srcPos + vec2( 1,  1)).rgb

	lumaM  := luma(rgbM)
	lumaNW := luma(rgbNW)
	lumaNE := luma(rgbNE)
	lumaSW := luma(rgbSW)
	lumaSE := luma(rgbSE)

	lumaMin := min(
		lumaM,
		min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)),
	)

	lumaMax := max(
		lumaM,
		max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)),
	)

	// Estimate the edge direction.
	dir := vec2(
		-((lumaNW + lumaNE) - (lumaSW + lumaSE)),
		 ((lumaNW + lumaSW) - (lumaNE + lumaSE)),
	)

	lumaSum := lumaNW + lumaNE + lumaSW + lumaSE

	dirReduce := max(
		lumaSum * (0.25 * fxaaReduceMul),
		fxaaReduceMin,
	)

	rcpDirMin := 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce)

	dir = clamp(
		dir * rcpDirMin,
		vec2(-fxaaSpanMax),
		vec2(fxaaSpanMax),
	)

	// Filter premultiplied RGB and alpha together to preserve transparency.
	// First candidate: two samples close to the edge centre.
	rgbaA := 0.5 * (
		sample(srcPos + dir*(1.0/3.0-0.5)) +
		sample(srcPos + dir*(2.0/3.0-0.5)))

	// Second candidate: extend further along the edge.
	rgbaB := rgbaA*0.5 + 0.25*(
		sample(srcPos + dir*(0.0/3.0-0.5)) +
		sample(srcPos + dir*(3.0/3.0-0.5)))

	lumaB := luma(rgbaB.rgb)

	if lumaB < lumaMin || lumaB > lumaMax {
		return rgbaA
	}

	return rgbaB
}
